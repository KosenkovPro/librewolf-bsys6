FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive
# The tools of the release are stored here. The runner overrides HOME in the
# container, so the path has to be given explicitly.
ENV MOZBUILD=/root/.mozbuild
ENV MOZBUILD_STATE_PATH=/root/.mozbuild

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates && \
    curl -qfLA "" --no-sessionid --proto =https --tlsv1.2 https://vcs.fi/api/packages/OSSign/debian/repository.key -o /etc/apt/keyrings/forgejo-OSSign.asc && \
    echo "deb [signed-by=/etc/apt/keyrings/forgejo-OSSign.asc] https://vcs.fi/api/packages/OSSign/debian stable main" > /etc/apt/sources.list.d/forgejo.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        gnupg lsb-release nodejs s3cmd ossign gawk git libnss3-tools libnss3 libnspr4 \
        make lbzip2 zip mono-complete jq gettext-base python3-pip xz-utils && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    # Install signmar
    curl -fL "https://librewolf.dev/api/packages/librewolf/generic/signmar/latest/signmar" -o "signmar" && \
    echo "ac0e32bedf1027fa292bf42a22ef4126885f08d58124a9cb84f1c2164cb831906eba28e581e3e7d88dd31791858525fadf6f4abc94139beefd997712e11ccb03 signmar" | sha512sum -c - && \
    chmod +x signmar && \
    mv signmar /usr/local/bin/ && \
    rm -rf /root/.mozbuild/chocolatey && \
    mkdir -p /root/.mozbuild/chocolatey && \
    curl -qfLA "" --no-sessionid --proto =https --tlsv1.2 https://github.com/chocolatey/choco/releases/download/2.7.5/chocolatey.v2.7.5.tar.gz | \
    tar -C /root/.mozbuild/chocolatey -xz && \
    printf '#!/bin/bash\nset -e\nmono "$(dirname $(readlink -f "$0"))/choco.exe" "$@"\n' > /root/.mozbuild/chocolatey/choco && \
    chmod +x /root/.mozbuild/chocolatey/choco && \
    pip3 install --break-system-packages azure-storage-blob
